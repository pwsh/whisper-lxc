# whisper appliance — copy to .env next to compose.yaml.
# setup-inside.sh writes this file for you; edit it and re-run prepare-models.sh
# plus `docker compose up -d` to change anything below.

# ---- what to serve ---------------------------------------------------------
# Comma-separated HuggingFace repos, which must already be OpenVINO IR (the
# `OpenVINO/` org publishes them).  In-server conversion of a plain transformers
# checkpoint does not work on this platform — it produces no model, silently.
#
# Each entry may carry an explicit alias with `repo=alias`; without one the alias
# is the repo basename minus its precision suffix, so
# `OpenVINO/whisper-large-v3-turbo-fp16-ov` becomes `whisper-large-v3-turbo`.
# The served names are then <alias>-<device>, lower-cased: whisper-large-v3-turbo-gpu.
MODELS=OpenVINO/whisper-large-v3-turbo-fp16-ov,OpenVINO/whisper-medium-fp16-ov

# Which accelerators each model is compiled for.  GPU, NPU, CPU, AUTO.
# Drop NPU on a host that has none (and use compose.gpu-only.yaml).
DEVICES=GPU,NPU

# The model the bare `whisper-gpu` / `whisper-npu` aliases point at.  Must be one
# of the aliases above; empty disables the short names.
DEFAULT_MODEL=whisper-large-v3-turbo

# ---- the server ------------------------------------------------------------
# Pin the weekly tag: :latest and :latest-gpu do not work on Lunar Lake.
OVMS_IMAGE_TAG=weekly
# Published on every interface — this is a LAN service by design.
PORT=8000
OVMS_LOG_LEVEL=INFO

# ---- the hardware ----------------------------------------------------------
# The gid of `render` INSIDE this guest (Debian 13: 992; the Proxmox node's own
# render gid is a different number and is not the one that matters).
# Check with: getent group render
RENDER_GID=992
GPU_DEV=/dev/dri/renderD128
NPU_DEV=/dev/accel/accel0

# On a GPU-only host, uncomment this and set DEVICES=GPU above:
# COMPOSE_FILE=compose.yaml:compose.gpu-only.yaml
